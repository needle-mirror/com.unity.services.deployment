.deployment-window-column-1 {
    width: 40%;
    flex: 1 1 40%;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 8px;
}

.deployment-window-column-2 {
    width: 13%;
    flex: 1 1 13%;
}

.deployment-window-column-3 {
    width: 12%;
    flex: 1 1 12%;
}

.deployment-window-column-4 {
    width: 15%;
    flex: 1 1 15%;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    overflow: hidden;
    padding-right: 8px;
}

.deployment-window-column-5 {
    width: 20%;
    flex: 1 1 20%;
    padding-right: 8px;
}

.variant-tag {
    -unity-font-style: normal;
    font-size: 10px;
    margin-right: 3px;
    margin-top: 1px;
    margin-bottom: 1px;
    padding: 1px 5px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--unity-colors-default-border);
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 0;
}

.variant-tag-overflow {
    -unity-font-style: normal;
    font-size: 10px;
    margin-right: 3px;
    margin-top: 1px;
    margin-bottom: 1px;
    padding: 1px 5px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--unity-colors-default-border);
    flex-shrink: 0;
    color: var(--unity-colors-default-text-disabled);
}

.center-content {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.status-message {
    margin: 4px 0;
    white-space: normal;
    -unity-text-align: upper-center;
    max-width: 320px;
}

.status-message__container {
    padding: 8px;
}

.status-button__container {
    margin-top: 6px;
}

.hidden {
    display: none;
}

.grow {
    flex-grow: 1;
}


.link-text {
    color: var(--unity-colors-link-text);
    background-image: none;
    background-color: transparent;
    border-width: 0 0 1px 0;
    border-color: var(--unity-colors-link-text);
    padding: 0;
    border-radius: 0;
}

.status-label{
    white-space: normal;
}
